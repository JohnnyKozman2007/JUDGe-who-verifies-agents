# Copy to .env and fill in. .env is gitignored and must never be committed.

# DeepInfra: required by generate.py and verify.py (all 4 models run through it)
# Get one at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# HuggingFace: required by data_loader.py for science only.
# GPQA-Diamond is a gated dataset, loading it fails without an accepted licence + token.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Silences a noisy HF warning on macOS
HF_HUB_DISABLE_SYMLINKS_WARNING=1
